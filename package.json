{
  "name": "yamusic-classic",
  "productName": "YM Classic",
  "version": "0.1.0",
  "description": "Неофициальный open-source клиент Яндекс Музыки в классическом дизайне",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "serve": "node server/cli.js",
    "start": "vite build && electron .",
    "electron": "electron .",
    "test": "vitest run",
    "dist": "vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "preact": "^11.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.krou4.ymclassic",
    "productName": "YM Classic",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@preact/signals": "^2.11.4"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "electron-winstaller@5.4.0": true
  }
}
